@model Lesson10Lab1.Models.Student

<div class="container mt-3">
    <form asp-controller="Student" asp-action="Create" method="post">
        <div class="mb-3 row">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên">
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email">
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Password" class="col-sm-2 col-form-label">Mật khẩu</label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password">
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select"
                        asp-items="Html.GetEnumSelectList<Branch>()"></select>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Hệ ĐT</label>
            <div class="col-sm-10 d-flex align-items-center">
                <input type="checkbox" class="form-check-input me-2" asp-for="IsRegular">
                <label class="form-check-label">Chính quy</label>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control">
            </div>
        </div>

        <!-- Giới tính làm ngắn gọn bằng GetEnumSelectList -->
        <div class="mb-3 row">
            <label asp-for="Gender" class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                <select asp-for="Gender" class="form-select"
                        asp-items="Html.GetEnumSelectList<Gender>()"></select>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>
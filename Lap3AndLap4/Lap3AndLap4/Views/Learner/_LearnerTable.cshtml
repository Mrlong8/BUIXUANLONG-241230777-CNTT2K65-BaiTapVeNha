@model IEnumerable<Lap3AndLap4.Models.Learner>

<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th>Mã</th>
            <th>Họ</th>
            <th>Tên</th>
            <th>Ngày Nhập Học</th>
            <th>Ngành học</th>
            <th>Chức Năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LearnerID</td>
                <td>@item.LastName</td>
                <td>@item.FirstMidName</td>
                <td>@(item.EnrollmentDate.ToString("dd/MM/yyyy"))</td>
                <td>@(item.Major?.MajorName)</td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.LearnerID">Edit</a>
                    <a class="btn btn-info btn-sm text-white" asp-action="Details" asp-route-id="@item.LearnerID">Details</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.LearnerID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

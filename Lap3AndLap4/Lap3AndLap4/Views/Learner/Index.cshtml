@model IEnumerable<Learner>
@{
    ViewData["Title"] = "Index";
}
<h1>Index</h1>
@await Component.InvokeAsync("Major")
<p><a class="btn btn-success" asp-action="Create">Create New</a></p>
<div id="content">
    @await Html.PartialAsync("LearnerTable", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#major-list').on('click', 'a', function (e) {
                e.preventDefault();

                $('#major-list a').removeClass('active');
                $(this).addClass('active');

                var id = $(this).data('id');
                console.log("Major ID:", id);

                $.ajax({
                    url: '@Url.Action("LearnerByMajorID", "Learner")',
                    type: 'GET',
                    data: { id: id },
                    success: function (response) {
                        $('#content').html(response);
                    },
                    error: function (xhr, status, error) {
                        console.error("Lỗi AJAX:", error);
                        console.log(xhr.responseText);
                    }
                });
            });
        });
    </script>
}

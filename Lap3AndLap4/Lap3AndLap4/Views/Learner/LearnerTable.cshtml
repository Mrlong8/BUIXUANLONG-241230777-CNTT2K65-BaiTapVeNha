@model IEnumerable<Learner>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Learner ID</th>
            <th>First Mid Name</th>
            <th>Last Name</th>
            <th>Major</th>
            <th>Enrollment Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LearnerID</td>
                <td>@item.FirstMidName</td>
                <td>@item.LastName</td>
                <td>@item.Major?.MajorName</td>
                <td>@item.EnrollmentDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LearnerID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.LearnerID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.LearnerID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<ul class="pagination">
    @for (int i = 1; i <= ViewBag.pageNum; i++)
    {
        <li class="page-item" page="@i"
            @(ViewBag.mid != null ? "mid=" + ViewBag.mid : "")
            @(ViewBag.keyword != null ? "keyword=" + ViewBag.keyword : "")>
            <a class="page-link" style="cursor: pointer;">@i</a>
        </li>
    }
</ul>
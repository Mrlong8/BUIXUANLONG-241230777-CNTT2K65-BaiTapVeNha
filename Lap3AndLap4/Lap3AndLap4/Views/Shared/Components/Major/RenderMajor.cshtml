@model IEnumerable<Major>

<ul class="nav nav-pills my-3" id="major-list">
    <li class="nav-item">
        <a class="nav-link active" href="#" data-id="" style="cursor: pointer;">Tất cả</a>
    </li>

    @foreach (var item in Model)
    {
        <li class="nav-item">
            <a class="nav-link" href="#" data-id="@item.MajorID" style="cursor: pointer;">
                @item.MajorName
            </a>
        </li>
    }
</ul>
